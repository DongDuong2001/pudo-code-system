{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pudo.dev/schemas/workflow.schema.json",
  "title": "PUDO Workflow Spec",
  "description": "Machine-readable workflow definition for the AI DevOS.",
  "type": "object",
  "required": ["id", "name", "version", "description", "inputs", "outputs", "phases"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "inputs": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "output_contract": { "type": "string" }
      }
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "workflows": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "prompts": { "type": "array", "items": { "type": "string" } },
        "templates": { "type": "array", "items": { "type": "string" } },
        "memory": { "type": "array", "items": { "type": "string" } }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "pudo_phase": {
            "type": "string",
            "enum": ["plan", "understand", "develop", "optimize", "release"]
          },
          "workflow": { "type": "string" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "prompts": { "type": "array", "items": { "type": "string" } },
          "gate": { "type": "string" },
          "exit_conditions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "decision_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trigger", "action"],
        "properties": {
          "trigger": { "type": "string" },
          "action": { "type": "string" }
        }
      }
    },
    "failure_modes": { "type": "array", "items": { "type": "string" } },
    "success_criteria": { "type": "array", "items": { "type": "string" } },
    "quality_gates": { "type": "array", "items": { "type": "string" } },
    "non_goals": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
